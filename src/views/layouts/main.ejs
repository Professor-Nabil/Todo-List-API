<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Todo App' %></title>
  <style>
    :root {
      --bg: #1e1e2e;
      --surface: #252538;
      --text: #cdd6f4;
      --primary: #cba6f7;
      --accent: #a6e3a1;
    }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    .container {
      background-color: var(--surface);
      padding: 2.5rem;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 420px;
      box-sizing: border-box;
      text-align: center;
    }
    h1 {
      margin-top: 0;
      color: var(--primary);
    }
    p {
      color: #a6adc8;
      line-height: 1.5;
    }
    .btn {
      display: inline-block;
      width: 100%;
      padding: 0.8rem;
      margin-top: 1rem;
      background-color: var(--primary);
      color: #11111b;
      font-weight: bold;
      text-decoration: none;
      border-radius: 6px;
      box-sizing: border-box;
      transition: opacity 0.2s ease;
    }
    .btn:hover {
      opacity: 0.9;
    }
    .btn-alt {
      background-color: #313244;
      color: var(--text);
      border: 1px solid #45475a;
    }
  </style>
</head>
<body>
  <div class="container">
    <%- body %>
  </div>
</body>
</html>
